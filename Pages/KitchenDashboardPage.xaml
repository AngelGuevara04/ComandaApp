<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             xmlns:converters="clr-namespace:ComandaApp.Converters"
             x:Class="ComandaApp.Pages.KitchenDashboardPage"
             x:DataType="vm:KitchenDashboardPageModel"
             x:Name="PageRoot"
             Title="Panel de Cocina">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotNullConverter x:Key="StringNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding CargarDatosCommand}">

        <Grid RowDefinitions="Auto,*"
              Padding="12"
              RowSpacing="12">

            <!-- HEADER AND TABS -->
            <FlexLayout Grid.Row="0" Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="0,0,0,10">
                    <Label Text="Cocina"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>

                    <Button Text="Órdenes" Command="{Binding VerOrdenesCommand}" CornerRadius="16" Padding="10,5">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoOrdenes}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoOrdenes}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="Menú" Command="{Binding VerDisponibilidadCommand}" CornerRadius="16" Padding="10,5">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoDisponibilidad}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding MostrandoDisponibilidad}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E0E0E0"/>
                                <Setter Property="TextColor" Value="Black"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>

                <Button Text="Salir"
                        Command="{Binding SalirRolCommand}"
                        BackgroundColor="#C0392B"
                        TextColor="White"
                        CornerRadius="16"
                        Padding="15,5"
                        Margin="0,0,0,10"/>
            </FlexLayout>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Row="1">

                <!-- VISTA: ORDENES ACTIVAS (Grouped Cards) -->
                <Grid IsVisible="{Binding MostrandoOrdenes}">
                    <Label Text="No hay órdenes pendientes en este momento."
                           IsVisible="{Binding NoHayOrdenes}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="Gray"
                           FontSize="18"/>

                    <CollectionView ItemsSource="{Binding OrdenesActivas}"
                                    IsVisible="{Binding HayOrdenes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:OrdenCocinaGroup">
                                <Border StrokeShape="RoundRectangle 16"
                                        Padding="16"
                                        Margin="0,0,0,15"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=AbrirOrdenCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                                            <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                            <Label Text="{Binding TiempoTranscurrido}" FontSize="14" TextColor="Gray"/>
                                        </FlexLayout>
                                        
                                        <Label Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}"
                                               FontSize="14" TextColor="Gray"
                                               IsVisible="{Binding NombreCliente, Converter={StaticResource StringNotNullConverter}}"/>
                                        
                                        <BoxView HeightRequest="1" Color="LightGray" Margin="0,5"/>
                                        
                                        <Label Text="{Binding TotalPlatillos, StringFormat='{0} platillos pendientes'}" FontSize="16" FontAttributes="Bold"/>
                                        
                                        <Button Text="Abrir Orden" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=AbrirOrdenCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                CornerRadius="16"
                                                Margin="0,10,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- VISTA: DETALLE DE ORDEN (Platillos específicos) -->
                <Grid IsVisible="{Binding MostrandoDetalle}">
                    <Grid RowDefinitions="Auto,*">
                        
                        <FlexLayout Grid.Row="0" Wrap="Wrap" AlignItems="Center" Margin="0,0,0,15">
                            <Button Text="← Volver" Command="{Binding VolverAOrdenesCommand}" BackgroundColor="#6C757D" TextColor="White" CornerRadius="16" Margin="0,0,10,0" Padding="10,5"/>
                            <Label Text="{Binding OrdenSeleccionada.NumeroMesa, StringFormat='Mesa {0}'}" FontSize="22" FontAttributes="Bold" VerticalOptions="Center"/>
                        </FlexLayout>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding OrdenSeleccionada.Platillos}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PedidoCocinaItem">
                                    <Border StrokeShape="RoundRectangle 16" Padding="14" Margin="0,0,0,12" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                        <VerticalStackLayout Spacing="10">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding NombrePlatillo}" FontSize="20" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                                <Label Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}" FontSize="16" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                                <Label Text="{Binding Notas, StringFormat='Notas: {0}'}" TextColor="#C0392B" FontAttributes="Italic" IsVisible="{Binding TieneNotas}" LineBreakMode="WordWrap"/>
                                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}" TextColor="Gray" FontSize="14"/>
                                            </VerticalStackLayout>

                                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                                <Button Text="Preparar"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=MarcarEnPreparacionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding PuedePreparar}"
                                                        BackgroundColor="#FFC107" TextColor="Black" CornerRadius="16" Margin="0,0,8,8" Padding="15,5"/>
                                                <Button Text="Listo"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=MarcarListoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding PuedeMarcarListo}"
                                                        BackgroundColor="#28A745" TextColor="White" CornerRadius="16" Margin="0,0,8,8" Padding="15,5"/>
                                                <Button Text="Rechazar"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=RechazarPedidoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#C0392B" TextColor="White" CornerRadius="16" Margin="0,0,0,8" Padding="15,5"/>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Grid>

                <!-- VISTA: DISPONIBILIDAD -->
                <Grid IsVisible="{Binding MostrandoDisponibilidad}">
                    <CollectionView ItemsSource="{Binding MenuRestaurante}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Platillo">
                                <Border StrokeShape="RoundRectangle 16" Padding="12" Margin="0,0,0,10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                                        <VerticalStackLayout Spacing="3" FlexLayout.Grow="1" FlexLayout.Basis="150" Margin="0,0,10,0">
                                            <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                            <Label Text="{Binding Precio, StringFormat='Precio: ${0:F2}'}" FontSize="14" TextColor="Gray"/>
                                            <Label FontSize="14" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstaDisponible}" Value="True">
                                                        <Setter Property="Text" Value="Disponible" />
                                                        <Setter Property="TextColor" Value="#28A745" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstaDisponible}" Value="False">
                                                        <Setter Property="Text" Value="No disponible" />
                                                        <Setter Property="TextColor" Value="#C0392B" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Button Text="Cambiar"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:KitchenDashboardPageModel}}, Path=AlternarDisponibilidadCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                CornerRadius="16" Padding="15,5"/>
                                    </FlexLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

            </Grid>

        </Grid>
    </RefreshView>
</ContentPage>