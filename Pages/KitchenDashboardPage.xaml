<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.KitchenDashboardPage"
             x:DataType="vm:KitchenDashboardPageModel"
             x:Name="PageRoot"
             Title="Panel de Cocina">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding CargarDatosCommand}">

        <Grid RowDefinitions="Auto,*"
              Padding="12"
              RowSpacing="12">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto">

                <Label Grid.Column="0"
                       Text="Panel de Cocina"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1F4E8E"
                       VerticalOptions="Center"/>

                <Button Grid.Column="1"
                        Text="Salir"
                        Command="{Binding SalirRolCommand}"
                        BackgroundColor="#C0392B"
                        TextColor="White"
                        CornerRadius="10"/>
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="6*,4*"
                  ColumnSpacing="14">

                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="12">

                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">

                            <Label Grid.Column="0"
                                   Text="Órdenes activas"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>

                            <Button Grid.Column="1"
                                    Text="Actualizar"
                                    Command="{Binding CargarDatosCommand}"
                                    BackgroundColor="#6C757D"
                                    TextColor="White"
                                    CornerRadius="10"/>
                        </Grid>

                        <Label Grid.Row="1"
                               Text="No hay pedidos pendientes."
                               IsVisible="{Binding NoHayPedidos}"
                               HorizontalOptions="Center"
                               TextColor="Gray"
                               Margin="0,10,0,0"/>

                        <CollectionView Grid.Row="2"
                                        ItemsSource="{Binding PedidosActivos}"
                                        IsVisible="{Binding HayPedidos}">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PedidoCocinaItem">

                                    <Border StrokeShape="RoundRectangle 10"
                                            Padding="14"
                                            Margin="0,0,0,12"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">

                                            <VerticalStackLayout Grid.Column="0"
                                                                 Spacing="4">

                                                <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#1F4E8E"/>

                                                <Label Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}"
                                                       FontSize="12"
                                                       TextColor="Gray"
                                                       IsVisible="{Binding TieneCliente}"/>

                                                <Label Text="{Binding NombrePlatillo}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"/>

                                                <Label Text="{Binding Cantidad, StringFormat='Cantidad: {0}'}"
                                                       FontSize="14"/>

                                                <Label Text="{Binding Notas, StringFormat='Notas: {0}'}"
                                                       TextColor="#C0392B"
                                                       FontAttributes="Italic"
                                                       IsVisible="{Binding TieneNotas}"/>

                                                <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                       TextColor="Gray"
                                                       FontSize="12"/>

                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="8"
                                                                 VerticalOptions="Center">

                                                <Button Text="Preparar"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.MarcarEnPreparacionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding PuedePreparar}"
                                                        BackgroundColor="#FFC107"
                                                        TextColor="Black"
                                                        CornerRadius="10"
                                                        WidthRequest="130"/>

                                                <Button Text="Listo"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.MarcarListoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding PuedeMarcarListo}"
                                                        BackgroundColor="#28A745"
                                                        TextColor="White"
                                                        CornerRadius="10"
                                                        WidthRequest="130"/>

                                                <Button Text="Rechazar"
                                                        Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RechazarPedidoCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#C0392B"
                                                        TextColor="White"
                                                        CornerRadius="10"
                                                        WidthRequest="130"/>

                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">

                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="12">

                        <Label Grid.Row="0"
                               Text="Disponibilidad del menú"
                               FontSize="20"
                               FontAttributes="Bold"/>

                        <CollectionView Grid.Row="1"
                                        ItemsSource="{Binding MenuRestaurante}">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Platillo">

                                    <Border StrokeShape="RoundRectangle 10"
                                            Padding="12"
                                            Margin="0,0,0,10"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">

                                            <VerticalStackLayout Grid.Column="0"
                                                                 Spacing="3">

                                                <Label Text="{Binding Nombre}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"/>

                                                <Label Text="{Binding Precio, StringFormat='Precio: ${0:F2}'}"
                                                       FontSize="12"
                                                       TextColor="Gray"/>

                                                <Label Text="{Binding EstaDisponible, StringFormat='Disponible: {0}'}"
                                                       FontSize="12"
                                                       TextColor="Gray"/>

                                            </VerticalStackLayout>

                                            <Button Grid.Column="1"
                                                    Text="Cambiar"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AlternarDisponibilidadCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#1F4E8E"
                                                    TextColor="White"
                                                    CornerRadius="10"
                                                    WidthRequest="100"
                                                    VerticalOptions="Center"/>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </RefreshView>
</ContentPage>