<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.MenuManagementPage"
             x:DataType="vm:MenuManagementPageModel"
             x:Name="PageRoot"
             Title="Gestión de Menú">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding CargarMenuCommand}">

        <ScrollView>
            <VerticalStackLayout Padding="18" Spacing="16">

                <Label Text="Gestión de menú"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#1F4E8E"/>

                <Border StrokeShape="RoundRectangle 14"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="{Binding TituloFormulario}"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nombre del Platillo" FontSize="14" TextColor="Gray" Margin="0,0,0,2" />
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference NombreEntry}, Path=Text.Length, StringFormat='{0}/50'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="NombreEntry" Placeholder="Nombre del platillo"
                               Text="{Binding NombreInput}"
                               MaxLength="50"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Descripción" FontSize="14" TextColor="Gray" Margin="0,0,0,2" />
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference DescEntry}, Path=Text.Length, StringFormat='{0}/150'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="DescEntry" Placeholder="Descripción breve"
                               Text="{Binding DescripcionInput}"
                               MaxLength="150"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Precio" FontSize="14" TextColor="Gray" Margin="0,0,0,2" />
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference PrecioEntry}, Path=Text.Length, StringFormat='{0}/10'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="PrecioEntry" Placeholder="Precio"
                               Text="{Binding PrecioInput}"
                               Keyboard="Numeric"
                               MaxLength="10"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Picker Grid.Column="0"
                                    Title="Selecciona una categoría"
                                    ItemsSource="{Binding CategoriasDisponibles}"
                                    SelectedItem="{Binding CategoriaInput}" />
                            <Button Grid.Column="1"
                                    Text="+ Nueva"
                                    Command="{Binding AgregarCategoriaCommand}"
                                    BackgroundColor="#28A745"
                                    TextColor="White"
                                    CornerRadius="10" />
                        </Grid>

                        <Border StrokeShape="RoundRectangle 16"
                                Stroke="#D1D5DB"
                                StrokeThickness="2"
                                StrokeDashArray="6,6"
                                BackgroundColor="#F3F4F6"
                                HorizontalOptions="Center"
                                WidthRequest="180"
                                HeightRequest="180">
                            <Grid>
                                <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="📷" FontSize="40" HorizontalOptions="Center"/>
                                    <Label Text="Tocar para subir" TextColor="#6B7280" FontSize="14" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                                <Image Source="{Binding ImagenMuestra}" Aspect="AspectFill" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeleccionarImagenCommand}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Button Text="{Binding TextoBotonGuardar}"
                                Command="{Binding GuardarPlatilloCommand}"
                                BackgroundColor="#1F4E8E"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="48"/>

                        <Button Text="Cancelar edición"
                                Command="{Binding CancelarEdicionCommand}"
                                IsVisible="{Binding IsEditing}"
                                BackgroundColor="#6C757D"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="44"/>

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <Label Grid.Column="0"
                           Text="Platillos registrados"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="1"
                            Text="Actualizar"
                            Command="{Binding CargarMenuCommand}"
                            BackgroundColor="#6C757D"
                            TextColor="White"
                            CornerRadius="10"/>
                </Grid>

                <Label Text="No hay platillos registrados."
                       IsVisible="{Binding NoHayPlatillos}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,20,0,0"/>

                <CollectionView ItemsSource="{Binding Platillos}"
                                IsVisible="{Binding HayPlatillos}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Platillo">

                            <Border StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    Margin="0,0,0,12"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="{Binding Nombre}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"/>

                                            <Label Text="{Binding Descripcion}"
                                                   FontSize="13"
                                                   TextColor="Gray"/>

                                            <Label Text="{Binding Categoria, StringFormat='Categoría: {0}'}"
                                                   FontSize="12"
                                                   TextColor="Gray"/>

                                            <Label Text="{Binding EstaDisponible, StringFormat='Disponible: {0}'}"
                                                   FontSize="12"
                                                   TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding Precio, StringFormat='${0:F2}'}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#1F4E8E"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">

                                        <Button Text="Editar"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditarPlatilloCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#1F4E8E"
                                                TextColor="White"
                                                CornerRadius="10"
                                                FlexLayout.Grow="1"
                                                Margin="2"/>

                                        <Button Text="Disp."
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CambiarDisponibilidadCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#FFC107"
                                                TextColor="Black"
                                                CornerRadius="10"
                                                FlexLayout.Grow="1"
                                                Margin="2"/>

                                        <Button Text="Eliminar"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EliminarPlatilloCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#C0392B"
                                                TextColor="White"
                                                CornerRadius="10"
                                                FlexLayout.Grow="1"
                                                Margin="2"/>

                                    </FlexLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>