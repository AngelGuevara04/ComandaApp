<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.MenuManagementPage"
             x:DataType="vm:MenuManagementPageModel"
             Title="Gestión de Menú">

    <Grid RowDefinitions="*, Auto" Padding="15">

        <CollectionView Grid.Row="0" ItemsSource="{Binding Platillos}">

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="El menú está vacío." TextColor="Gray" FontSize="18" HorizontalOptions="Center"/>
                    <Label Text="Agrega platillos para comenzar." TextColor="LightGray" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Platillo">
                    <SwipeView Margin="0,5">

                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Eliminar" 
                                           BackgroundColor="Red" 
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MenuManagementPageModel}}, Path=EliminarPlatilloCommand}"
                                           CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border StrokeShape="RoundRectangle 10" Padding="10" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                            <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">

                                <Image Grid.Column="0" Source="{Binding ImagenSource}" Aspect="AspectFill" HeightRequest="70" WidthRequest="70"/>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="18"/>
                                    <Label Text="{Binding Categoria}" FontSize="12" TextColor="Gray"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="2" 
                                       Text="{Binding Precio, StringFormat='${0:F2}'}" 
                                       VerticalOptions="Center" 
                                       FontAttributes="Bold" 
                                       FontSize="18"
                                       TextColor="#28A745"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" 
                Text="Nuevo Platillo" 
                Command="{Binding AgregarPlatilloCommand}" 
                Margin="10" 
                HeightRequest="60"
                FontAttributes="Bold"
                BackgroundColor="#512BD4"/>
    </Grid>
</ContentPage>