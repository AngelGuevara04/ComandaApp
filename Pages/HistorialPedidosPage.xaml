<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.HistorialPedidosPage"
             x:DataType="vm:HistorialPedidosPageModel"
             Title="Historial de pedidos">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding CargarHistorialCommand}">

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <Label Text="Historial de pedidos"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}"/>

                <Border StrokeShape="RoundRectangle 24"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Seleccionar fecha"
                               FontSize="16"
                               FontAttributes="Bold"/>

                        <DatePicker Date="{Binding FechaSeleccionada}"/>

                        <Button Text="Consultar"
                                Command="{Binding CargarHistorialCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="16"
                                HeightRequest="48"/>

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 24"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#172336}">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Órdenes"
                                   FontSize="13"
                                   TextColor="Gray"/>

                            <Label Text="{Binding TotalOrdenes}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 24"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#172336}">

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Total vendido"
                                   FontSize="13"
                                   TextColor="Gray"/>

                            <Label Text="{Binding TotalDia, StringFormat='${0:F2}'}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <Label Text="No hay pedidos pagados en esta fecha."
                       IsVisible="{Binding NoHayOrdenes}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,20,0,0"/>

                <CollectionView ItemsSource="{Binding OrdenesPagadas}"
                                IsVisible="{Binding HayOrdenes}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OrdenMesa">

                            <Border StrokeShape="RoundRectangle 24"
                                    Padding="16"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding MesaAsignada.NumeroMesa, StringFormat='Mesa {0}'}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"/>

                                            <Label Text="{Binding NombreCliente, StringFormat='Cliente: {0}'}"
                                                   FontSize="13"
                                                   TextColor="Gray"/>

                                            <Label Text="{Binding FechaCreacion, StringFormat='Fecha: {0:dd/MM/yyyy HH:mm}'}"
                                                   FontSize="12"
                                                   TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding TotalCuenta, StringFormat='${0:F2}'}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Platillos}"
                                                         Spacing="6">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:DetallePedido">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="8"
                                                      Padding="0,4">

                                                    <Label Grid.Column="0"
                                                           Text="{Binding Cantidad, StringFormat='{0}x'}"
                                                           FontAttributes="Bold"/>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                        <Label Text="{Binding NombrePlatillo}"
                                                               FontAttributes="Bold"/>

                                                        <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                               FontSize="12"
                                                               TextColor="Gray"/>
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="2"
                                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>