<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.AddDevicePage"
             x:DataType="vm:AddDevicePageModel"
             Title="{Binding TituloFormulario}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout Spacing="15" IsVisible="{Binding FormularioVisible}">
                <Label Text="Completar Datos" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 12" Padding="20" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PromptNombre}" FontAttributes="Bold" TextColor="Gray"/>
                                <Label Grid.Column="1" Text="{Binding Source={x:Reference NomDevEntry}, Path=Text.Length, StringFormat='{0}/50'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                            </Grid>
                            <Entry x:Name="NomDevEntry" Text="{Binding NombreInput}" Placeholder="Escribe aquí..." MaxLength="50"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding PromptDetalle}" FontAttributes="Bold" TextColor="Gray"/>
                                <Label Grid.Column="1" Text="{Binding Source={x:Reference DetDevEntry}, Path=Text.Length, StringFormat='{0}/100'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                            </Grid>
                            <Entry x:Name="DetDevEntry" Text="{Binding DetalleInput}" Placeholder="Escribe aquí..." MaxLength="100"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Generar QR de Acceso" 
                        Command="{Binding GenerarQRCommand}" 
                        BackgroundColor="#512BD4" 
                        HeightRequest="55" 
                        FontAttributes="Bold" 
                        Margin="0,20,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding QrGenerado}" HorizontalOptions="Center">
                <Label Text="¡Dispositivo Registrado!" FontSize="22" FontAttributes="Bold" TextColor="#28A745" HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 12" Padding="30" BackgroundColor="White" HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                        <Image Source="{Binding QrImageSource}" WidthRequest="220" HeightRequest="220" Aspect="AspectFit" HorizontalOptions="Center"/>

                        <Label Text="Escanea este código con el dispositivo" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label Text="{Binding QrCodeData}" FontAttributes="Bold" TextColor="Black" HorizontalOptions="Center" FontSize="12"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Regresar al Gestor" 
                        Command="{Binding VolverCommand}" 
                        BackgroundColor="#6C757D" 
                        HeightRequest="55" 
                        FontAttributes="Bold"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>