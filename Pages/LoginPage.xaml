<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.LoginPage"
             x:DataType="pm:LoginPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="28,56,28,32" Spacing="0">

            <Label Text="ComandaApp"
                   FontSize="34"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

            <Label Text="Sistema de gestión de pedidos"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark=#888}"
                   Margin="0,4,0,36"/>

            <VerticalStackLayout IsVisible="{Binding ShowRegisterForm}" Spacing="14">

                <Label Text="Crear cuenta de administrador"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource Gray200}}"
                       Margin="0,0,0,4"/>

                <Label Text="Registra las credenciales del administrador."
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}"
                       Margin="0,0,0,8"/>

                <Border StrokeShape="RoundRectangle 24"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}"
                        Padding="20,16">

                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nombre completo" FontSize="12" TextColor="Gray" Margin="0,0,0,2"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference RegNombreEntry}, Path=Text.Length, StringFormat='{0}/50'}" TextColor="Gray" FontSize="11" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="RegNombreEntry" Placeholder="Nombre completo"
                               Text="{Binding DisplayName}"
                               Keyboard="Text"
                               MaxLength="50"
                               ReturnType="Next"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Correo electrónico" FontSize="12" TextColor="Gray" Margin="0,0,0,2"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference RegEmailEntry}, Path=Text.Length, StringFormat='{0}/100'}" TextColor="Gray" FontSize="11" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="RegEmailEntry" Placeholder="Correo electrónico"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               MaxLength="100"
                               ReturnType="Next"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,48" ColumnSpacing="4">
                            <Entry Grid.Column="0"
                                   Placeholder="Contraseña"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                   ReturnType="Next"/>

                            <Button Grid.Column="1"
                                    Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToEyeTextConverter}}"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    BackgroundColor="Transparent"
                                    FontSize="18"
                                    Padding="0"/>
                        </Grid>

                        <Entry Placeholder="Confirmar contraseña"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               ReturnType="Done"
                               ReturnCommand="{Binding RegisterCommand}"/>

                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource Danger}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasError}"/>

                <Button Text="Crear cuenta"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="52"
                        FontSize="16"
                        FontAttributes="Bold"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="¿Ya tienes cuenta?"
                           VerticalOptions="Center"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>

                    <Button Text="Iniciar sesión"
                            Command="{Binding ShowLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            Padding="0"/>
                </HorizontalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"/>

            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding ShowRegisterForm, Converter={StaticResource InvertedBoolConverter}}"
                                 Spacing="14">

                <Grid ColumnDefinitions="*,*"
                      HorizontalOptions="Center"
                      WidthRequest="280"
                      ColumnSpacing="6"
                      Margin="0,0,0,8">

                    <Button Grid.Column="0"
                            Text="Credenciales"
                            Command="{Binding SelectCredentialsCommand}"
                            BackgroundColor="{Binding IsCredentialsMode, Converter={StaticResource BoolToSelectedColorConverter}}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="42"
                            FontSize="13"
                            FontAttributes="{Binding IsCredentialsMode, Converter={StaticResource BoolToFontAttributesConverter}}"/>

                    <Button Grid.Column="1"
                            Text="Código QR"
                            Command="{Binding SelectQrCommand}"
                            BackgroundColor="{Binding IsQrMode, Converter={StaticResource BoolToSelectedColorConverter}}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="42"
                            FontSize="13"
                            FontAttributes="{Binding IsQrMode, Converter={StaticResource BoolToFontAttributesConverter}}"/>
                </Grid>

                <VerticalStackLayout IsVisible="{Binding IsCredentialsMode}" Spacing="12">

                    <Border StrokeShape="RoundRectangle 24"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}"
                            Padding="20,16">

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Correo electrónico" FontSize="12" TextColor="Gray" Margin="0,0,0,2"/>
                                <Label Grid.Column="1" Text="{Binding Source={x:Reference LogEmailEntry}, Path=Text.Length, StringFormat='{0}/100'}" TextColor="Gray" FontSize="11" VerticalOptions="End"/>
                            </Grid>
                            <Entry x:Name="LogEmailEntry" Placeholder="Correo electrónico"
                                   Text="{Binding Email}"
                                   Keyboard="Email"
                                   MaxLength="100"
                                   ReturnType="Next"
                                   ClearButtonVisibility="WhileEditing"/>

                            <Grid ColumnDefinitions="*,48" ColumnSpacing="4">
                                <Entry Grid.Column="0"
                                       Placeholder="Contraseña"
                                       Text="{Binding Password}"
                                       IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                       ReturnType="Done"
                                       ReturnCommand="{Binding LoginCommand}"/>

                                <Button Grid.Column="1"
                                        Text="{Binding IsPasswordVisible, Converter={StaticResource BoolToEyeTextConverter}}"
                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                        BackgroundColor="Transparent"
                                        FontSize="18"
                                        Padding="0"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}"/>

                    <Button Text="Iniciar sesión"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold"/>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="¿Aún no tienes cuenta?"
                               VerticalOptions="Center"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>

                        <Button Text="Registrarte"
                                Command="{Binding ShowRegisterCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                Padding="0"/>
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>

                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsQrMode}" Spacing="12">

                    <Border StrokeShape="RoundRectangle 24"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}"
                            Padding="20,16">

                        <VerticalStackLayout Spacing="12">

                            <Label Text="Ingresa el código generado desde el panel de admin"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Código de acceso" FontSize="12" TextColor="Gray" Margin="0,0,0,2"/>
                                <Label Grid.Column="1" Text="{Binding Source={x:Reference QrEntry}, Path=Text.Length, StringFormat='{0}/200'}" TextColor="Gray" FontSize="11" VerticalOptions="End"/>
                            </Grid>
                            <Entry x:Name="QrEntry" Placeholder="Código QR del dispositivo"
                                   Text="{Binding QrToken}"
                                   MaxLength="200"
                                   ClearButtonVisibility="WhileEditing"
                                   ReturnType="Done"
                                   ReturnCommand="{Binding LoginWithQrCommand}"/>

                            <Button Text="Escanear con cámara"
                                    Command="{Binding AbrirScannerCommand}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}"
                                    TextColor="{StaticResource Primary}"
                                    CornerRadius="16"
                                    HeightRequest="44"/>

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding HasError}"/>

                    <Button Text="Acceder con código"
                            Command="{Binding LoginWithQrCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>