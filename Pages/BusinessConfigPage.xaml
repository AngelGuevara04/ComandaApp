<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.BusinessConfigPage"
             x:DataType="vm:BusinessConfigPageModel"
             Title="Configurar Restaurante">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Información del Negocio" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#512BD4"/>

            <Border StrokeShape="RoundRectangle 16" Padding="20" BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nombre del Restaurante" FontAttributes="Bold" TextColor="Gray"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference NomResEntry}, Path=Text.Length, StringFormat='{0}/50'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="NomResEntry" Placeholder="Ej. Taquería El Fogón" Text="{Binding Config.NombreRestaurante}" MaxLength="50"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="RFC" FontAttributes="Bold" TextColor="Gray"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference RfcEntry}, Path=Text.Length, StringFormat='{0}/13'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="RfcEntry" Placeholder="Ej. XAXX010101000" Text="{Binding Config.Rfc}" MaxLength="13"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Dirección" FontAttributes="Bold" TextColor="Gray"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference DirEntry}, Path=Text.Length, StringFormat='{0}/100'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="DirEntry" Placeholder="Calle, Colonia, Ciudad" Text="{Binding Config.Direccion}" MaxLength="100"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="URL del Logo (Opcional)" FontAttributes="Bold" TextColor="Gray"/>
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference LogoEntry}, Path=Text.Length, StringFormat='{0}/200'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="LogoEntry" Placeholder="https://..." Text="{Binding Config.LogoUrl}" MaxLength="200"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar Cambios" 
                    Command="{Binding GuardarConfiguracionCommand}" 
                    HeightRequest="55"
                    FontAttributes="Bold"
                    Margin="0,15,0,0"
                    BackgroundColor="#28A745"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>