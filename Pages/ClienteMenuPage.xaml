<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.ClienteMenuPage"
             x:DataType="vm:ClienteMenuPageModel"
             x:Name="PageRoot"
             Title="ComandaApp"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*"
          BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="18,18,18,12"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="ComandaApp"
                       FontSize="12"
                       TextColor="Gray"/>

                <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}"
                       FontSize="24"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="End"/>

                <Label Text="{Binding TotalGeneral, StringFormat='${0:F2}'}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F4E8E"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,Auto"
              BackgroundColor="{AppThemeBinding Light=#EAEAEA, Dark=#2A2A2A}">

            <Button Grid.Column="0"
                    Text="Menú"
                    Command="{Binding VerMenuCommand}"
                    BackgroundColor="#1F4E8E"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="52"/>

            <Button Grid.Column="1"
                    Text="Mis pedidos"
                    Command="{Binding VerMisPedidosCommand}"
                    BackgroundColor="#A0A0A0"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="52"/>

            <Button Grid.Column="2"
                    Text="Actualizar"
                    Command="{Binding ActualizarCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="52"/>
        </Grid>

        <Grid Grid.Row="2">

            <ScrollView IsVisible="{Binding MostrandoMenu}">
                <VerticalStackLayout Padding="16" Spacing="14">

                    <Label Text="No hay platillos disponibles."
                           IsVisible="{Binding NoHayPlatillos}"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Margin="0,40,0,0"/>

                    <CollectionView ItemsSource="{Binding PlatillosConCantidad}"
                                    IsVisible="{Binding HayPlatillos}">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlatilloEnCarrito">

                                <Border StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,12"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                    <VerticalStackLayout Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                <Label Text="{Binding Platillo.Nombre}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"/>

                                                <Label Text="{Binding Platillo.Descripcion}"
                                                       FontSize="13"
                                                       TextColor="Gray"/>

                                                <Label Text="{Binding Platillo.Categoria}"
                                                       FontSize="12"
                                                       TextColor="Gray"/>
                                            </VerticalStackLayout>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Platillo.Precio, StringFormat='${0:F2}'}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   TextColor="#1F4E8E"
                                                   VerticalOptions="Center"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="12">

                                            <Button Grid.Column="0"
                                                    Text="-"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.QuitarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#C0392B"
                                                    TextColor="White"
                                                    CornerRadius="10"
                                                    WidthRequest="48"/>

                                            <Label Grid.Column="1"
                                                   Text="{Binding Cantidad}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center"/>

                                            <Button Grid.Column="2"
                                                    Text="+"
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AgregarCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#28A745"
                                                    TextColor="White"
                                                    CornerRadius="10"
                                                    WidthRequest="48"/>

                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding TotalCarrito, StringFormat='Confirmar pedido ${0:F2}'}"
                            Command="{Binding ConfirmarPedidoCommand}"
                            IsVisible="{Binding TieneItemsEnCarrito}"
                            BackgroundColor="#1F4E8E"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="52"
                            Margin="0,10,0,20"/>

                </VerticalStackLayout>
            </ScrollView>

            <ScrollView IsVisible="{Binding MostrandoMisPedidos}">
                <VerticalStackLayout Padding="16" Spacing="14">

                    <Label Text="No tienes pedidos confirmados."
                           IsVisible="{Binding NoHayPedidos}"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Margin="0,40,0,0"/>

                    <CollectionView ItemsSource="{Binding PedidosConfirmados}"
                                    IsVisible="{Binding HayPedidos}">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DetallePedido">

                                <Border StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,12"
                                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="{Binding Cantidad, StringFormat='{0}x'}"
                                               FontSize="18"
                                               FontAttributes="Bold"/>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="{Binding NombrePlatillo}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"/>

                                            <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                   FontSize="12"
                                                   TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#1F4E8E"
                                               VerticalOptions="Center"/>

                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="{Binding TotalConfirmado, StringFormat='Solicitar pago ${0:F2}'}"
                            Command="{Binding SolicitarPagoCommand}"
                            IsVisible="{Binding PuedeSolicitarPago}"
                            BackgroundColor="#28A745"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="52"
                            Margin="0,10,0,20"/>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>