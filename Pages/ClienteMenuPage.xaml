<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.ClienteMenuPage"
             x:DataType="vm:ClienteMenuPageModel"
             x:Name="PageRoot"
             Title="ComandaApp"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*"
          BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="18,18,18,12"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">

            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="ComandaApp"
                       FontSize="12"
                       TextColor="Gray"/>

                <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}"
                       FontSize="24"
                       FontAttributes="Bold"/>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="Total"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="End"/>

                <Label Text="{Binding TotalGeneral, StringFormat='${0:F2}'}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              BackgroundColor="{AppThemeBinding Light=#EAEAEA, Dark={StaticResource Gray900}}">

            <Button Grid.Column="0"
                    Text="Menú"
                    Command="{Binding VerMenuCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="52"/>

            <Button Grid.Column="1"
                    Text="Mis pedidos"
                    Command="{Binding VerMisPedidosCommand}"
                    BackgroundColor="#A0A0A0"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="52"/>
        </Grid>

        <Grid Grid.Row="2" Padding="16">

            <Grid IsVisible="{Binding MostrandoMenu}">
                <Label Text="No hay platillos disponibles."
                       IsVisible="{Binding NoHayPlatillos}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,40,0,0"/>

                <CollectionView ItemsSource="{Binding PlatillosConCantidad}"
                                IsVisible="{Binding HayPlatillos}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlatilloEnCarrito">
                            <Border StrokeShape="RoundRectangle 24"
                                    Padding="14"
                                    Margin="0,0,0,12"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Image Source="{Binding Platillo.ImagenSource}" Aspect="AspectFill" HeightRequest="90" WidthRequest="90"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Platillo.Nombre}" FontSize="16" FontAttributes="Bold"/>
                                            <Label Grid.Column="1" Text="{Binding Platillo.Precio, StringFormat='${0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                        </Grid>
                                        <Label Text="{Binding Platillo.Descripcion}" FontSize="12" TextColor="Gray" MaxLines="2" LineBreakMode="TailTruncation"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,0">
                                            <Button Grid.Column="0" Text="-" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClienteMenuPageModel}}, Path=QuitarCommand}" CommandParameter="{Binding .}" BackgroundColor="#C0392B" TextColor="White" CornerRadius="16" WidthRequest="40" HeightRequest="35" Padding="0"/>
                                            <Label Grid.Column="1" Text="{Binding Cantidad}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalOptions="Center"/>
                                            <Button Grid.Column="2" Text="+" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ClienteMenuPageModel}}, Path=AgregarCommand}" CommandParameter="{Binding .}" BackgroundColor="#28A745" TextColor="White" CornerRadius="16" WidthRequest="40" HeightRequest="35" Padding="0"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                    <CollectionView.Footer>
                        <Button Text="{Binding TotalCarrito, StringFormat='Confirmar pedido ${0:F2}'}"
                                Command="{Binding ConfirmarPedidoCommand}"
                                IsVisible="{Binding TieneItemsEnCarrito}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="16"
                                HeightRequest="52"
                                Margin="0,10,0,20"/>
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>

            <Grid IsVisible="{Binding MostrandoMisPedidos}">
                <Label Text="No tienes pedidos confirmados."
                       IsVisible="{Binding NoHayPedidos}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,40,0,0"/>

                <CollectionView ItemsSource="{Binding PedidosConfirmados}"
                                IsVisible="{Binding HayPedidos}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DetallePedido">
                            <Border StrokeShape="RoundRectangle 24"
                                    Padding="14"
                                    Margin="0,0,0,12"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding Cantidad, StringFormat='{0}x'}" FontSize="18" FontAttributes="Bold"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding NombrePlatillo}" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Estado, StringFormat='Estado: {0}'}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Subtotal, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <Button Text="{Binding TotalConfirmado, StringFormat='Solicitar pago ${0:F2}'}"
                                Command="{Binding SolicitarPagoCommand}"
                                IsVisible="{Binding PuedeSolicitarPago}"
                                BackgroundColor="#28A745"
                                TextColor="White"
                                CornerRadius="16"
                                HeightRequest="52"
                                Margin="0,10,0,20"/>
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>

        </Grid>

        <Grid Grid.Row="0" Grid.RowSpan="3" 
              IsVisible="{Binding MostrandoBienvenida}"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
              Padding="24">
            
            <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                <Label Text="¡Bienvenido!"
                       FontSize="32"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
                
                <Label Text="Por favor, ingresa tu nombre para comenzar tu pedido."
                       FontSize="16"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                       
                <Entry Placeholder="Tu nombre"
                       Text="{Binding NombreClienteInput}"
                       MaxLength="50"
                       Margin="0,20,0,0"
                       FontSize="18"
                       HorizontalTextAlignment="Center"/>
                       
                <Button Text="Comenzar Pedido"
                        Command="{Binding ComenzarPedidoCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="16"
                        HeightRequest="52"
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>