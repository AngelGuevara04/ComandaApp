<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.AdminDashboardPage"
             x:DataType="vm:AdminDashboardPageModel"
             Title="Centro de Mando">

	<ScrollView>
		<VerticalStackLayout Padding="30" Spacing="30">
			<Label Text="Administración" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />

			<Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="20">

				<Border Grid.Column="0" StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#E0E0E0" Padding="20">
					<VerticalStackLayout Spacing="15" HorizontalOptions="Center">
						<Label Text="Mesas" FontAttributes="Bold" HorizontalOptions="Center" />
						<Button Text="Configurar" Command="{Binding GoToMesasCommand}" />
					</VerticalStackLayout>
				</Border>

				<Border Grid.Column="1" StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#E0E0E0" Padding="20">
					<VerticalStackLayout Spacing="15" HorizontalOptions="Center">
						<Label Text="Menú" FontAttributes="Bold" HorizontalOptions="Center" />
						<Button Text="Gestionar" Command="{Binding GoToMenuCommand}" />
					</VerticalStackLayout>
				</Border>

			</Grid>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>