<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.AdminDashboardPage"
             x:DataType="vm:AdminDashboardPageModel"
             Title="Centro de Mando">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">
            <Label Text="Panel de Administración" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#512BD4"/>
            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="Auto,Auto,Auto" 
                  ColumnSpacing="15" 
                  RowSpacing="15">

                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Mesas y QR" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Button Text="Entrar" Command="{Binding GoToMesasCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Menú" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Button Text="Gestionar" Command="{Binding GoToMenuCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Dispositivos" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Button Text="Vincular" Command="{Binding GoToDevicesCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="15">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Corte de Caja" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Button Text="Ver" Command="{Binding GoToCorteCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 12" Padding="15">
                    <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                        <Label Text="Reportes e Historial" VerticalOptions="Center" FontAttributes="Bold" />
                        <Button Text="Consultar Pedidos" Command="{Binding GoToHistoryCommand}" WidthRequest="200" />
                    </HorizontalStackLayout>
                </Border>

            </Grid>

            <Button Text="Configuración del Restaurante" 
                    Command="{Binding GoToConfigCommand}"
                    BackgroundColor="#808080"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>