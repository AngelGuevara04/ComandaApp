<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             x:Class="ComandaApp.Pages.AdminDashboardPage"
             x:DataType="vm:AdminDashboardPageModel"
             Title="Centro de Mando">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="25">

            <Label Text="Panel de Administración" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="#512BD4"/>

            <Grid ColumnDefinitions="*,*" 
                  RowDefinitions="Auto,Auto,Auto" 
                  ColumnSpacing="15" 
                  RowSpacing="15">

                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Mesas y QR" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Gestión de accesos" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Entrar" Command="{Binding AbrirMesasCommand}" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Menú" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Platillos y precios" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Gestionar" Command="{Binding AbrirMenuCommand}" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Dispositivos" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Caja, Cocina, etc." FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Vincular" Command="{Binding AbrirDispositivosCommand}" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Corte de Caja" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Finanzas del día" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Ver" Command="{Binding AbrirCorteCommand}" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Reportes e Historial" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Consulta de pedidos por día" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Consultar Pedidos" Command="{Binding AbrirHistorialCommand}" WidthRequest="220" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label Text="Gestión de Dispositivos (QR)" FontAttributes="Bold" HorizontalOptions="Center" FontSize="16"/>
                        <Label Text="Mesas, Cajas y Cocinas" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                        <Button Text="Administrar Accesos" Command="{Binding AbrirDispositivosCommand}" WidthRequest="250" BackgroundColor="#512BD4"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Button Text="Configuración del Restaurante" 
                    Command="{Binding AbrirConfigCommand}"
                    BackgroundColor="#6C757D"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>