<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.TableManagementPage"
             x:DataType="vm:TableManagementPageModel"
             Title="Gestión de Mesas">

    <Grid RowDefinitions="*, Auto" Padding="20">
        <CollectionView Grid.Row="0" ItemsSource="{Binding Mesas}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Mesa">
                    <Border StrokeShape="RoundRectangle 10" Margin="0,5" Padding="15">
                        <HorizontalStackLayout Spacing="20">
                            <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="{Binding Area}" VerticalOptions="Center" TextColor="Gray"/>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="1" Text="Agregar Nueva Mesa" Command="{Binding AgregarMesaCommand}" />
    </Grid>
</ContentPage>