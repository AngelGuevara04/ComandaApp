<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ComandaApp.PageModels"
             xmlns:models="clr-namespace:ComandaApp.Models"
             x:Class="ComandaApp.Pages.CajaDashboardPage"
             x:Name="PageRoot"
             Title="Caja">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsBusy}"
                     Command="{Binding CargarOrdenesCommand}">

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Panel de Caja"
                           FontSize="28"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{StaticResource Primary}"/>

                    <Button Grid.Column="1"
                            Text="Salir"
                            Command="{Binding SalirRolCommand}"
                            BackgroundColor="#C0392B"
                            TextColor="White"
                            CornerRadius="16"/>
                </Grid>

                <Border StrokeShape="RoundRectangle 24"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="12">

                        <Label Text="Generar acceso temporal"
                               FontSize="18"
                               FontAttributes="Bold"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Nombre del cliente" FontSize="14" TextColor="Gray" Margin="0,0,0,2" />
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference NombreCliEntry}, Path=Text.Length, StringFormat='{0}/30'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="NombreCliEntry" Placeholder="Nombre del cliente"
                               Text="{Binding NombreClienteTemporal}"
                               MaxLength="30"
                               ClearButtonVisibility="WhileEditing"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="NÃºmero de mesa" FontSize="14" TextColor="Gray" Margin="0,0,0,2" />
                            <Label Grid.Column="1" Text="{Binding Source={x:Reference NumMesaEntry}, Path=Text.Length, StringFormat='{0}/20'}" TextColor="Gray" FontSize="12" VerticalOptions="End"/>
                        </Grid>
                        <Entry x:Name="NumMesaEntry" Placeholder="NÃºmero de mesa"
                               Text="{Binding NumeroMesaTemporal}"
                               Keyboard="Text"
                               MaxLength="20"
                               ClearButtonVisibility="WhileEditing"/>

                        <Button Text="Generar QR temporal"
                                Command="{Binding GenerarQrTemporalCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="16"
                                HeightRequest="48"/>

                        <Border IsVisible="{Binding TieneQrTemporal}"
                                StrokeShape="RoundRectangle 16"
                                Padding="12"
                                BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#172336}">

                            <VerticalStackLayout Spacing="10"
                                                 HorizontalOptions="Center">

                                <Label Text="QR temporal del cliente"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"/>

                                <Border StrokeShape="RoundRectangle 16"
                                        Padding="18"
                                        BackgroundColor="White"
                                        HorizontalOptions="Center">

                                    <Image Source="{Binding QrTemporalImageSource}"
                                           WidthRequest="230"
                                           HeightRequest="230"
                                           Aspect="AspectFit"/>
                                </Border>

                                <Label Text="{Binding QrTemporal}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       WidthRequest="280"/>

                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="Ã“rdenes activas"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="1"
                            Text="Actualizar"
                            Command="{Binding CargarOrdenesCommand}"
                            BackgroundColor="#6C757D"
                            TextColor="White"
                            CornerRadius="16"/>
                </Grid>

                <Label Text="No hay Ã³rdenes activas."
                       IsVisible="{Binding NoHayOrdenes}"
                       HorizontalOptions="Center"
                       TextColor="Gray"
                       Margin="0,20,0,0"/>

                <CollectionView ItemsSource="{Binding MesasActivas}"
                                IsVisible="{Binding HayOrdenes}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MesaCajaGroup">

                            <Border StrokeShape="RoundRectangle 24"
                                    Padding="16"
                                    Margin="0,0,0,14"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding NumeroMesa, StringFormat='Mesa {0}'}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"/>

                                            <Label Text="{Binding NombresClientes, StringFormat='Clientes: {0}'}"
                                                   FontSize="13"
                                                   TextColor="Gray"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding TotalCuenta, StringFormat='${0:F2}'}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"/>
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Platillos}"
                                                         Spacing="6">

                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:DetallePedido">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="8"
                                                      Padding="0,4">

                                                    <Label Grid.Column="0"
                                                           Text="{Binding Cantidad, StringFormat='{0}x'}"
                                                           FontAttributes="Bold"/>

                                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                        <Label Text="{Binding NombrePlatillo}"
                                                               FontAttributes="Bold"/>

                                                        <Label Text="{Binding Estado, StringFormat='Estado: {0}'}"
                                                               FontSize="12"
                                                               TextColor="Gray"/>
                                                    </VerticalStackLayout>

                                                    <Label Grid.Column="2"
                                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                                           FontAttributes="Bold"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="Cobrar cuenta"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CajaDashboardPageModel}}, Path=PrepararCobroCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#28A745"
                                            TextColor="White"
                                            CornerRadius="16"
                                            HeightRequest="48"/>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>

        <!-- VISTA: COBRO (Overlay) -->
        <Grid BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE000000}"
              IsVisible="{Binding MostrandoCobro}">
            <Border StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="24"
                    WidthRequest="350">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Cobro de Cuenta" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{StaticResource Primary}"/>
                    
                    <Label Text="{Binding MesaACobrar.NumeroMesa, StringFormat='Mesa {0}'}" FontSize="18" HorizontalOptions="Center"/>
                    
                    <Grid ColumnDefinitions="*,Auto" Margin="0,10">
                        <Label Text="Total a cobrar:" FontSize="18" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding MesaACobrar.TotalCuenta, StringFormat='${0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#C0392B"/>
                    </Grid>

                    <Label Text="Monto recibido:" FontSize="14" TextColor="Gray" Margin="0,0,0,-10"/>
                    <Entry Placeholder="0.00" Keyboard="Numeric" Text="{Binding MontoRecibidoText}" FontSize="18" HorizontalTextAlignment="End"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,20">
                        <Label Text="Cambio:" FontSize="18" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding Cambio, StringFormat='${0:F2}'}" FontSize="24" FontAttributes="Bold" TextColor="#28A745"/>
                    </Grid>

                    <Button Text="Finalizar pago"
                            Command="{Binding FinalizarPagoCommand}"
                            IsEnabled="{Binding PuedeFinalizarPago}"
                            BackgroundColor="#28A745"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="48"
                            Margin="0,0,0,10"/>

                    <Button Text="Cancelar"
                            Command="{Binding CancelarCobroCommand}"
                            BackgroundColor="#6C757D"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="48"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
