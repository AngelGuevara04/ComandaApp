<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ComandaApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:ComandaApp.Pages"
       Shell.FlyoutBehavior="Disabled"
       Shell.TabBarIsVisible="False"
       Title="ComandaApp">

    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate pages:LoginPage}"
                  Route="login" />

    <ShellContent Title="Admin"
                  ContentTemplate="{DataTemplate pages:AdminDashboardPage}"
                  Route="admin_dashboard" />

    <ShellContent Title="Cliente"
                  ContentTemplate="{DataTemplate pages:ClienteMenuPage}"
                  Route="cliente_menu" />

    <ShellContent Title="Cocina"
                  ContentTemplate="{DataTemplate pages:KitchenDashboardPage}"
                  Route="kitchen_dashboard" />

    <ShellContent Title="Caja"
                  ContentTemplate="{DataTemplate pages:CajaDashboardPage}"
                  Route="caja_dashboard" />

</Shell>